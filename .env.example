# Copy to .env and fill in. Never commit .env.

# Which provider to use: "nvidia" (free dev endpoint, for development) or "nebius" (Token Factory, used for the submission)
PROVIDER=nvidia

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

TAVILY_API_KEY=

# Model IDs. Easiest: run `python -m patchwright configure` and it fills the provider-specific lines below.
# Provider-specific variables win over the shared ones.
NANO_MODEL=
SUPER_MODEL=
ULTRA_MODEL=
# NEBIUS_NANO_MODEL=
# NEBIUS_SUPER_MODEL=
# NEBIUS_ULTRA_MODEL=

# Optional: override the estimated prices (USD per 1M tokens), see patchwright/prices.json
# SUPER_PRICE_IN=0.30
# SUPER_PRICE_OUT=0.90

# Optional: GitHub token, only needed to open pull requests
GITHUB_TOKEN=

# Web app options
# DEMO_MODE=1            public hosting: bundled bugs only, no custom repos
# MAX_CONCURRENT_RUNS=2
# HOST=127.0.0.1
# PORT=8000
